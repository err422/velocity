{
  "entities": {
    "DailyCourse": {
      "title": "DailyCourse",
      "description": "A canonical seeded daily movement course identified by UTC date key.",
      "type": "object",
      "properties": {
        "dateKey": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "UTC calendar date key in YYYY-MM-DD format."
        },
        "seed": {
          "type": "string",
          "pattern": "^[A-Z0-9\\-]+$",
          "minLength": 4,
          "maxLength": 64,
          "description": "Canonical deterministic seed string for generating course geometry."
        },
        "lengthTier": {
          "type": "string",
          "enum": ["short", "medium", "long"],
          "description": "Rolled course length category."
        },
        "segmentCount": {
          "type": "integer",
          "description": "Total generated movement segments between Start and Finish."
        },
        "mechanics": {
          "type": "array",
          "description": "Bounded list of movement segment types featured in this course (max 8)."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Public visibility flag for daily archive listing."
        },
        "createdBy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the authenticated player who first registered the daily record."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the daily course record was registered."
        }
      },
      "required": [
        "dateKey",
        "seed",
        "lengthTier",
        "segmentCount",
        "mechanics",
        "isPublic",
        "createdBy",
        "createdAt"
      ]
    },
    "DailyRun": {
      "title": "DailyRun",
      "description": "An authenticated player's personal best leaderboard entry on a specific daily course.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the runner (matches document ID)."
        },
        "dateKey": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "Parent daily course UTC date key."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Public runner display name shown on the leaderboard."
        },
        "bestTime": {
          "type": "number",
          "description": "Fastest finish time in seconds (strictly positive, <= 3600)."
        },
        "splits": {
          "type": "array",
          "description": "Bounded list of gate split timestamps in seconds (max 32)."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Public visibility flag for leaderboard listing."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server timestamp of initial submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest personal best improvement."
        }
      },
      "required": [
        "uid",
        "dateKey",
        "displayName",
        "bestTime",
        "splits",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Private per-player preferences including display name, aim sensitivity, FOV, crosshair customization, and control keybinds.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the owner (matches document ID)."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "Optional custom display name shown on daily leaderboards."
        },
        "sensitivity": {
          "type": "number",
          "description": "Mouse look sensitivity multiplier (0.2 to 4.0)."
        },
        "invertY": {
          "type": "boolean",
          "description": "Whether vertical mouse pitch is inverted."
        },
        "baseFov": {
          "type": "number",
          "description": "Base vertical field of view in degrees (70 to 115)."
        },
        "crosshair": {
          "type": "object",
          "description": "Native map describing crosshair style, pixel size, and hex color.",
          "properties": {
            "style": {
              "type": "string",
              "enum": ["cross", "dot", "cross-dot", "circle", "none"]
            },
            "size": {
              "type": "number"
            },
            "color": {
              "type": "string",
              "enum": ["#c9f8ff", "#ffffff", "#7dff8b", "#ff9b55", "#ff5e8a"]
            }
          },
          "required": ["style", "size", "color"]
        },
        "viewmodel": {
          "type": "object",
          "description": "Native map describing first-person knife viewmodel X/Y/Z offsets (-2.5..2.5) and FOV (54..72).",
          "properties": {
            "offsetX": { "type": "number" },
            "offsetY": { "type": "number" },
            "offsetZ": { "type": "number" },
            "fov": { "type": "number" }
          },
          "required": ["offsetX", "offsetY", "offsetZ", "fov"]
        },
        "keybinds": {
          "type": "object",
          "description": "Native map of all 19 gameplay and combat action input tokens (KeyboardEvent.code or Mouse0..Mouse4).",
          "properties": {
            "forward": { "type": "string", "minLength": 1, "maxLength": 24 },
            "back": { "type": "string", "minLength": 1, "maxLength": 24 },
            "left": { "type": "string", "minLength": 1, "maxLength": 24 },
            "right": { "type": "string", "minLength": 1, "maxLength": 24 },
            "jump": { "type": "string", "minLength": 1, "maxLength": 24 },
            "slide": { "type": "string", "minLength": 1, "maxLength": 24 },
            "grapple": { "type": "string", "minLength": 1, "maxLength": 24 },
            "burst": { "type": "string", "minLength": 1, "maxLength": 24 },
            "fire": { "type": "string", "minLength": 1, "maxLength": 24 },
            "altFire": { "type": "string", "minLength": 1, "maxLength": 24 },
            "reload": { "type": "string", "minLength": 1, "maxLength": 24 },
            "slotRifle": { "type": "string", "minLength": 1, "maxLength": 24 },
            "slotAwp": { "type": "string", "minLength": 1, "maxLength": 24 },
            "slotDeagle": { "type": "string", "minLength": 1, "maxLength": 24 },
            "slotKnife": { "type": "string", "minLength": 1, "maxLength": 24 },
            "restart": { "type": "string", "minLength": 1, "maxLength": 24 },
            "checkpoint": { "type": "string", "minLength": 1, "maxLength": 24 },
            "ghost": { "type": "string", "minLength": 1, "maxLength": 24 },
            "inspect": { "type": "string", "minLength": 1, "maxLength": 24 }
          },
          "required": [
            "forward",
            "back",
            "left",
            "right",
            "jump",
            "slide",
            "grapple",
            "burst",
            "fire",
            "altFire",
            "reload",
            "slotRifle",
            "slotAwp",
            "slotDeagle",
            "slotKnife",
            "restart",
            "checkpoint",
            "ghost",
            "inspect"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server timestamp of initial settings creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest settings update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "sensitivity",
        "invertY",
        "baseFov",
        "crosshair",
        "viewmodel",
        "keybinds",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserInventory": {
      "title": "UserInventory",
      "description": "Private owner-only summary of coin balance, equipped knife, equipped gloves, equipped firearm skins, CS case counts, and unboxing stats.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "coins": {
          "type": "integer",
          "description": "Current player coin balance (0..9999999)."
        },
        "equippedKnifeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "equippedGloveId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "equippedRifleId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "equippedAwpId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "equippedDeagleId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "caseCounts": {
          "type": "object",
          "properties": {
            "velocity": { "type": "integer" },
            "chroma": { "type": "integer" },
            "spectrum": { "type": "integer" }
          },
          "required": ["velocity", "chroma", "spectrum"]
        },
        "totalOpened": {
          "type": "integer"
        },
        "lastDailyDropDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "coins",
        "equippedKnifeId",
        "equippedGloveId",
        "equippedRifleId",
        "equippedAwpId",
        "equippedDeagleId",
        "caseCounts",
        "totalOpened",
        "lastDailyDropDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "KnifeItem": {
      "title": "KnifeItem",
      "description": "An individual unboxed or starter 3D knife skin owned by a player.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "knifeType": {
          "type": "string",
          "enum": ["default", "karambit", "butterfly", "m9", "skeleton"]
        },
        "skinId": {
          "type": "string",
          "enum": ["vanilla", "ultraviolet", "damascus", "crimson_web", "slaughter", "tiger_tooth", "fade", "marble_fade", "doppler", "case_hardened"]
        },
        "rarity": {
          "type": "string",
          "enum": ["milspec", "restricted", "classified", "covert", "gold"]
        },
        "patternSeed": {
          "type": "integer"
        },
        "floatValue": {
          "type": "number"
        },
        "wearGrade": {
          "type": "string",
          "enum": ["FN", "MW", "FT", "WW", "BS"]
        },
        "specialTag": {
          "type": "string",
          "enum": ["", "BLUE GEM", "RUBY", "SAPPHIRE", "BLACK PEARL", "FIRE & ICE", "FULL FADE", "PHASE 1", "PHASE 2", "PHASE 3", "PHASE 4"]
        },
        "bluePct": {
          "type": "integer"
        },
        "caseId": {
          "type": "string",
          "enum": ["starter", "velocity", "chroma", "spectrum"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "id",
        "knifeType",
        "skinId",
        "rarity",
        "patternSeed",
        "floatValue",
        "wearGrade",
        "specialTag",
        "bluePct",
        "caseId",
        "createdAt"
      ]
    },
