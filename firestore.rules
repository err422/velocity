rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Reusable Hardened Primitives ----------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- Validation Blueprints ----------
    function isValidDailyCourse(data, dateKey) {
      return data.keys().hasAll([
          'dateKey',
          'seed',
          'lengthTier',
          'segmentCount',
          'mechanics',
          'isPublic',
          'createdBy',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'dateKey',
          'seed',
          'lengthTier',
          'segmentCount',
          'mechanics',
          'isPublic',
          'createdBy',
          'createdAt'
        ])
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey == dateKey
        && data.seed is string
        && data.seed.size() >= 4
        && data.seed.size() <= 64
        && data.seed.matches('^[A-Z0-9\\-]+$')
        && data.lengthTier is string
        && data.lengthTier.size() >= 4
        && data.lengthTier.size() <= 10
        && data.lengthTier in ['short', 'medium', 'long']
        && data.segmentCount is int
        && data.segmentCount >= 5
        && data.segmentCount <= 15
        && data.mechanics is list
        && data.mechanics.size() >= 1
        && data.mechanics.size() <= 8
        && data.mechanics[0] is string
        && data.mechanics.hasOnly(['ramp', 'gaps', 'wallrun', 'surf', 'slide', 'grapple', 'pads'])
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdBy is string
        && data.createdBy.size() >= 1
        && data.createdBy.size() <= 128
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidDailyRunShape(data, dateKey, uid) {
      return data.keys().hasAll([
          'uid',
          'dateKey',
          'displayName',
          'bestTime',
          'splits',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'dateKey',
          'displayName',
          'bestTime',
          'splits',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey == dateKey
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && data.bestTime is number
        && data.bestTime > 1.0
        && data.bestTime <= 3600.0
        && data.splits is list
        && data.splits.size() >= 1
        && data.splits.size() <= 32
        && data.splits[0] is number
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyRunCreate(data, dateKey, uid) {
      return isValidDailyRunShape(data, dateKey, uid)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidDailyRunUpdate(data, dateKey, uid) {
      return isValidDailyRunShape(data, dateKey, uid)
        && data.updatedAt == request.time;
    }

    function isValidInputToken(tok) {
      return tok is string
        && tok.size() >= 1
        && tok.size() <= 24
        && tok.matches('^[A-Za-z0-9_]+$')
        && tok != 'Escape';
    }

    function isValidCrosshairMap(c) {
      return c is map
        && c.keys().hasAll(['style', 'size', 'color'])
        && c.keys().hasOnly(['style', 'size', 'color'])
        && c.style is string
        && c.style.size() >= 3
        && c.style.size() <= 12
        && c.style in ['cross', 'dot', 'cross-dot', 'circle', 'none']
        && c.size is number
        && c.size >= 8
        && c.size <= 28
        && c.color is string
        && c.color.size() == 7
        && c.color in ['#c9f8ff', '#ffffff', '#7dff8b', '#ff9b55', '#ff5e8a'];
    }

    function isValidKeybindsMap(k) {
      return k is map
        && k.keys().hasAll([
          'forward',
          'back',
          'left',
          'right',
          'jump',
          'slide',
          'grapple',
          'burst',
          'fire',
          'altFire',
          'reload',
          'slotRifle',
          'slotAwp',
          'slotDeagle',
          'slotKnife',
          'restart',
          'checkpoint',
          'ghost',
          'inspect'
        ])
        && k.keys().hasOnly([
          'forward',
          'back',
          'left',
          'right',
          'jump',
          'slide',
          'grapple',
          'burst',
          'fire',
          'altFire',
          'reload',
          'slotRifle',
          'slotAwp',
          'slotDeagle',
          'slotKnife',
          'restart',
          'checkpoint',
          'ghost',
          'inspect'
        ])
        && isValidInputToken(k.forward)
        && isValidInputToken(k.back)
        && isValidInputToken(k.left)
        && isValidInputToken(k.right)
        && isValidInputToken(k.jump)
        && isValidInputToken(k.slide)
        && isValidInputToken(k.grapple)
        && isValidInputToken(k.burst)
        && isValidInputToken(k.fire)
        && isValidInputToken(k.altFire)
        && isValidInputToken(k.reload)
        && isValidInputToken(k.slotRifle)
        && isValidInputToken(k.slotAwp)
        && isValidInputToken(k.slotDeagle)
        && isValidInputToken(k.slotKnife)
        && isValidInputToken(k.restart)
        && isValidInputToken(k.checkpoint)
        && isValidInputToken(k.ghost)
        && isValidInputToken(k.inspect);
    }

    function isValidViewmodelMap(v) {
      return v is map
        && v.keys().hasAll(['offsetX', 'offsetY', 'offsetZ', 'fov'])
        && v.keys().hasOnly(['offsetX', 'offsetY', 'offsetZ', 'fov'])
        && v.offsetX is number
        && v.offsetX >= -2.5
        && v.offsetX <= 2.5
        && v.offsetY is number
        && v.offsetY >= -2.5
        && v.offsetY <= 2.5
        && v.offsetZ is number
        && v.offsetZ >= -2.5
        && v.offsetZ <= 2.5
        && v.fov is number
        && v.fov >= 54
        && v.fov <= 72;
    }

    function isValidUserSettingsShape(data, uid) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'sensitivity',
          'invertY',
          'baseFov',
          'crosshair',
          'viewmodel',
          'keybinds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'sensitivity',
          'invertY',
          'baseFov',
          'crosshair',
          'viewmodel',
          'keybinds',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 0
        && data.displayName.size() <= 32
        && data.sensitivity is number
        && data.sensitivity >= 0.2
        && data.sensitivity <= 4.0
        && data.invertY is bool
        && data.baseFov is number
        && data.baseFov >= 70
        && data.baseFov <= 115
        && isValidCrosshairMap(data.crosshair)
        && isValidViewmodelMap(data.viewmodel)
        && isValidKeybindsMap(data.keybinds)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSettingsCreate(data, uid) {
      return isValidUserSettingsShape(data, uid)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserSettingsUpdate(data, uid) {
      return isValidUserSettingsShape(data, uid)
        && data.updatedAt == request.time;
    }

    function isValidCaseCountsMap(c) {
      return c is map
        && c.keys().hasAll(['velocity', 'chroma', 'spectrum', 'blacksite', 'overdrive', 'eclipse'])
        && c.keys().hasOnly(['velocity', 'chroma', 'spectrum', 'blacksite', 'overdrive', 'eclipse', 'ronin'])
        && c.velocity is int
        && c.velocity >= 0
        && c.velocity <= 999
        && c.chroma is int
        && c.chroma >= 0
        && c.chroma <= 999
        && c.spectrum is int
        && c.spectrum >= 0
        && c.spectrum <= 999
        && c.blacksite is int
        && c.blacksite >= 0
        && c.blacksite <= 999
        && c.overdrive is int
        && c.overdrive >= 0
        && c.overdrive <= 999
        && c.eclipse is int
        && c.eclipse >= 0
        && c.eclipse <= 999
        && (!('ronin' in c) || (c.ronin is int && c.ronin >= 0 && c.ronin <= 999));
    }

    function isValidUserInventoryShape(data, uid) {
      return data.keys().hasAll([
          'uid',
          'coins',
          'equippedKnifeId',
          'equippedGloveId',
          'equippedRifleId',
          'equippedAwpId',
          'equippedDeagleId',
          'caseCounts',
          'totalOpened',
          'lastDailyDropDate',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'coins',
          'equippedKnifeId',
          'equippedGloveId',
          'equippedRifleId',
          'equippedAwpId',
          'equippedDeagleId',
          'caseCounts',
          'totalOpened',
          'lastDailyDropDate',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.coins is int
        && data.coins >= 0
        && data.coins <= 9999999
        && data.equippedKnifeId is string
        && data.equippedKnifeId.size() >= 1
        && data.equippedKnifeId.size() <= 64
        && data.equippedKnifeId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.equippedGloveId is string
        && data.equippedGloveId.size() >= 1
        && data.equippedGloveId.size() <= 64
        && data.equippedGloveId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.equippedRifleId is string
        && data.equippedRifleId.size() >= 1
        && data.equippedRifleId.size() <= 64
        && data.equippedRifleId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.equippedAwpId is string
        && data.equippedAwpId.size() >= 1
        && data.equippedAwpId.size() <= 64
        && data.equippedAwpId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.equippedDeagleId is string
        && data.equippedDeagleId.size() >= 1
        && data.equippedDeagleId.size() <= 64
        && data.equippedDeagleId.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidCaseCountsMap(data.caseCounts)
        && data.totalOpened is int
        && data.totalOpened >= 0
        && data.totalOpened <= 99999
        && data.lastDailyDropDate is string
        && data.lastDailyDropDate.size() >= 0
        && data.lastDailyDropDate.size() <= 10
        && (data.lastDailyDropDate == '' || data.lastDailyDropDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserInventoryCreate(data, uid) {
      return isValidUserInventoryShape(data, uid)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserInventoryUpdate(data, uid) {
      return isValidUserInventoryShape(data, uid)
        && data.updatedAt == request.time;
    }

    function isValidKnifeItemCreate(data, uid, knifeId) {
      return data.keys().hasAll([
          'uid',
          'id',
          'knifeType',
          'skinId',
          'rarity',
          'patternSeed',
          'floatValue',
          'wearGrade',
          'specialTag',
          'bluePct',
          'caseId',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'id',
          'knifeType',
          'skinId',
          'rarity',
          'patternSeed',
          'floatValue',
          'wearGrade',
          'specialTag',
          'bluePct',
          'caseId',
          'createdAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 64
        && data.id == knifeId
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.knifeType is string
        && data.knifeType.size() >= 2
        && data.knifeType.size() <= 16
        && data.knifeType in ['default', 'karambit', 'butterfly', 'm9', 'skeleton']
        && data.skinId is string
        && data.skinId.size() >= 4
        && data.skinId.size() <= 24
        && data.skinId in ['vanilla', 'ultraviolet', 'damascus', 'crimson_web', 'slaughter', 'tiger_tooth', 'fade', 'marble_fade', 'doppler', 'case_hardened', 'emberstrike', 'arctic_veil']
        && data.rarity is string
        && data.rarity.size() >= 4
        && data.rarity.size() <= 16
        && data.rarity in ['milspec', 'restricted', 'classified', 'covert', 'gold']
        && data.patternSeed is int
        && data.patternSeed >= 0
        && data.patternSeed <= 999
        && data.floatValue is number
        && data.floatValue >= 0.0
        && data.floatValue <= 1.0
        && data.wearGrade is string
        && data.wearGrade.size() == 2
        && data.wearGrade in ['FN', 'MW', 'FT', 'WW', 'BS']
        && data.specialTag is string
        && data.specialTag.size() >= 0
        && data.specialTag.size() <= 20
        && data.specialTag in ['', 'BLUE GEM', 'RUBY', 'SAPPHIRE', 'BLACK PEARL', 'FIRE & ICE', 'FULL FADE', 'PHASE 1', 'PHASE 2', 'PHASE 3', 'PHASE 4']
        && data.bluePct is int
        && data.bluePct >= 0
        && data.bluePct <= 100
        && data.caseId is string
        && data.caseId.size() >= 5
        && data.caseId.size() <= 16
        && data.caseId in ['starter', 'velocity', 'chroma', 'spectrum', 'blacksite', 'overdrive', 'eclipse', 'ronin']
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidGloveItemCreate(data, uid, gloveId) {
      return data.keys().hasAll([
          'uid',
          'id',
          'gloveType',
          'skinId',
          'rarity',
          'patternSeed',
          'floatValue',
          'wearGrade',
          'specialTag',
          'bluePct',
          'caseId',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'id',
          'gloveType',
          'skinId',
          'rarity',
          'patternSeed',
          'floatValue',
          'wearGrade',
          'specialTag',
          'bluePct',
          'caseId',
          'createdAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 64
        && data.id == gloveId
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.gloveType is string
        && data.gloveType.size() >= 5
        && data.gloveType.size() <= 16
        && data.gloveType in ['standard', 'sport', 'specialist', 'wraps']
        && data.skinId is string
        && data.skinId.size() >= 4
        && data.skinId.size() <= 24
        && data.skinId in [
          'tactical_slate',
          'case_hardened',
          'vice',
          'pandoras_box',
          'hedge_maze',
          'slingshot',
          'crimson_kimono',
          'emerald_web',
          'fade',
          'leather',
          'slaughter',
          'cobalt_skulls',
          'overprint',
          'breachline',
          'stormgrid',
          'eclipse_mantle'
        ]
        && data.rarity is string
        && data.rarity.size() >= 4
        && data.rarity.size() <= 16
        && data.rarity in ['milspec', 'restricted', 'classified', 'covert', 'gold']
        && data.patternSeed is int
        && data.patternSeed >= 0
        && data.patternSeed <= 999
        && data.floatValue is number
        && data.floatValue >= 0.0
        && data.floatValue <= 1.0
        && data.wearGrade is string
        && data.wearGrade.size() == 2
        && data.wearGrade in ['FN', 'MW', 'FT', 'WW', 'BS']
        && data.specialTag is string
        && data.specialTag.size() >= 0
        && data.specialTag.size() <= 20
        && data.specialTag in ['', 'BLUE GEM', 'RUBY', 'SAPPHIRE', 'BLACK PEARL', 'FIRE & ICE', 'FULL FADE', 'PHASE 1', 'PHASE 2', 'PHASE 3', 'PHASE 4']
        && data.bluePct is int
        && data.bluePct >= 0
        && data.bluePct <= 100
        && data.caseId is string
        && data.caseId.size() >= 5
        && data.caseId.size() <= 16
        && data.caseId in ['starter', 'velocity', 'chroma', 'spectrum', 'blacksite', 'overdrive', 'eclipse', 'ronin']
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidWeaponItemCreate(data, uid, weaponId) {
      return data.keys().hasAll([
          'uid',
          'id',
          'weaponType',
          'skinId',
          'rarity',
          'patternSeed',
          'floatValue',
          'wearGrade',
          'specialTag',
          'bluePct',
          'caseId',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'id',
          'weaponType',
          'skinId',
          'rarity',
          'patternSeed',
          'floatValue',
          'wearGrade',
          'specialTag',
          'bluePct',
          'caseId',
          'createdAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 64
        && data.id == weaponId
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.weaponType is string
        && data.weaponType.size() >= 3
        && data.weaponType.size() <= 12
        && data.weaponType in [
          'rifle',
          'famas',
          'scar',
          'honeybadger',
          'smg',
          'mp7',
          'shotgun',
          'sawedoff',
          'leverslug',
          'awp',
          'dmr',
          'scout',
          'katana',
          'revolver',
          'deagle',
          'pistol',
          'g18',
          'akimbo',
          'usps'
        ]
        && data.skinId is string
        && data.skinId.size() >= 4
        && data.skinId.size() <= 24
        && data.skinId in [
          'factory_slate',
          'ultraviolet',
          'redline',
          'damascus',
          'vulcan',
          'crimson_web',
          'asiimov',
          'blaze',
          'neon_rider',
          'printstream',
          'hyper_chroma',
          'fade',
          'case_hardened',
          'dragon_gold',
          'hazard_pay',
          'coldfront',
          'redshift',
          'nitro',
          'solarflare',
          'voidglass',
          'tactical_carbon',
          'cyber_wireframe',
          'holo_prism',
          'molten_magma',
          'ronin_sakura',
          'oni_crimson',
          'shogun_gold',
          'reactive_overdrive',
          'reactive_oni',
          'camo_gold',
          'camo_diamond',
          'camo_dark_matter'
        ]
        && data.rarity is string
        && data.rarity.size() >= 4
        && data.rarity.size() <= 16
        && data.rarity in ['milspec', 'restricted', 'classified', 'covert', 'gold']
        && data.patternSeed is int
        && data.patternSeed >= 0
        && data.patternSeed <= 999
        && data.floatValue is number
        && data.floatValue >= 0.0
        && data.floatValue <= 1.0
        && data.wearGrade is string
        && data.wearGrade.size() == 2
        && data.wearGrade in ['FN', 'MW', 'FT', 'WW', 'BS']
        && data.specialTag is string
        && data.specialTag.size() >= 0
        && data.specialTag.size() <= 20
        && data.specialTag in ['', 'BLUE GEM', 'RUBY', 'SAPPHIRE', 'BLACK PEARL', 'FIRE & ICE', 'FULL FADE', 'PHASE 1', 'PHASE 2', 'PHASE 3', 'PHASE 4']
        && data.bluePct is int
        && data.bluePct >= 0
        && data.bluePct <= 100
        && data.caseId is string
        && data.caseId.size() >= 5
        && data.caseId.size() <= 16
        && data.caseId in ['starter', 'velocity', 'chroma', 'spectrum', 'blacksite', 'overdrive', 'eclipse', 'ronin']
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidLobbyShape(data, lobbyId) {
      return data.keys().hasAll([
          'lobbyId',
          'hostUid',
          'hostName',
          'roomName',
          'mapId',
          'mode',
          'maxPlayers',
          'playerCount',
          'status',
          'isPrivate',
          'joinCode',
          'createdAt',
          'heartbeatAt'
        ])
        && data.keys().hasOnly([
          'lobbyId',
          'hostUid',
          'hostName',
          'roomName',
          'mapId',
          'mode',
          'maxPlayers',
          'playerCount',
          'status',
          'isPrivate',
          'joinCode',
          'createdAt',
          'heartbeatAt'
        ])
        && data.lobbyId is string
        && data.lobbyId.size() >= 1
        && data.lobbyId.size() <= 64
        && data.lobbyId == lobbyId
        && data.hostUid is string
        && data.hostUid.size() >= 1
        && data.hostUid.size() <= 128
        && data.hostName is string
        && data.hostName.size() >= 1
        && data.hostName.size() <= 32
        && data.roomName is string
        && data.roomName.size() >= 1
        && data.roomName.size() <= 32
        && data.mapId is string
        && data.mapId.size() >= 6
        && data.mapId.size() <= 20
        && data.mapId in ['arena_surf', 'arena_aim', 'arena_spire', 'arena_cargo', 'arena_skyline', 'arena_canyon']
        && data.mode is string
        && data.mode.size() >= 6
        && data.mode.size() <= 12
        && data.mode in ['duel_1v1', 'ffa_4p']
        && data.maxPlayers is int
        && ((data.mode == 'duel_1v1' && data.maxPlayers == 2) || (data.mode == 'ffa_4p' && data.maxPlayers == 4))
        && data.playerCount is int
        && data.playerCount >= 1
        && data.playerCount <= data.maxPlayers
        && data.status is string
        && data.status.size() >= 4
        && data.status.size() <= 16
        && data.status in ['open', 'in_progress', 'closed']
        && data.isPrivate is bool
        && data.joinCode is string
        && data.joinCode.size() >= 0
        && data.joinCode.size() <= 4
        && (data.joinCode == '' || data.joinCode.matches('^[A-Z0-9]{4}$'))
        && data.createdAt is timestamp
        && data.heartbeatAt is timestamp;
    }

    function isValidLobbyCreate(data, lobbyId) {
      return isValidLobbyShape(data, lobbyId)
        && data.hostUid == request.auth.uid
        && data.createdAt == request.time
        && data.heartbeatAt == request.time;
    }

    function isValidLobbyUpdate(data, lobbyId) {
      return isValidLobbyShape(data, lobbyId)
        && data.hostUid == request.auth.uid
        && data.heartbeatAt == request.time;
    }

    function isValidLobbyPeerShape(data, peerUid) {
      return data.keys().hasAll([
          'peerUid',
          'hostUid',
          'displayName',
          'offerSdp',
          'answerSdp',
          'offerCandidates',
          'answerCandidates',
          'state',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'peerUid',
          'hostUid',
          'displayName',
          'offerSdp',
          'answerSdp',
          'offerCandidates',
          'answerCandidates',
          'state',
          'createdAt',
          'updatedAt'
        ])
        && data.peerUid is string
        && data.peerUid.size() >= 1
        && data.peerUid.size() <= 128
        && data.peerUid == peerUid
        && data.hostUid is string
        && data.hostUid.size() >= 1
        && data.hostUid.size() <= 128
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 32
        && data.offerSdp is string
        && data.offerSdp.size() >= 1
        && data.offerSdp.size() <= 16384
        && data.answerSdp is string
        && data.answerSdp.size() >= 0
        && data.answerSdp.size() <= 16384
        && data.offerCandidates is list
        && data.offerCandidates.size() >= 0
        && data.offerCandidates.size() <= 30
        && (data.offerCandidates.size() == 0 || data.offerCandidates[0] is string)
        && data.answerCandidates is list
        && data.answerCandidates.size() >= 0
        && data.answerCandidates.size() <= 30
        && (data.answerCandidates.size() == 0 || data.answerCandidates[0] is string)
        && data.state is string
        && data.state.size() >= 6
        && data.state.size() <= 12
        && data.state in ['offering', 'answered', 'closed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLoadoutSlot(slot, allowedWeapons, attSlots) {
      let a = slot.attachments;
      return slot is map
        && slot.size() == 3
        && slot.weaponId in allowedWeapons
        && a is map
        && (a.size() <= 5 || (a.size() == 6 && 'apex' in a))
        && a.keys().hasOnly(attSlots)
        && slot.skinItemId is string
        && slot.skinItemId.size() <= 64;
    }

    function isValidLoadoutEntry(l, expectedId, primWep, secWep, attSlots) {
      let m = l.melee;
      return l is map
        && l.keys().hasAll(['id', 'name', 'primary', 'secondary', 'melee'])
        && l.keys().hasOnly(['id', 'name', 'primary', 'secondary', 'melee', 'scorestreakId'])
        && l.id == expectedId
        && l.name is string
        && l.name.size() >= 1
        && l.name.size() <= 24
        && isValidLoadoutSlot(l.primary, primWep, attSlots)
        && isValidLoadoutSlot(l.secondary, secWep, attSlots)
        && m is map
        && m.size() == 1
        && m.knifeItemId is string
        && m.knifeItemId.size() <= 64
        && (!('scorestreakId' in l) || (
          l.scorestreakId is string
          && l.scorestreakId.size() >= 3
          && l.scorestreakId.size() <= 20
          && l.scorestreakId in ['rpg', 'minigun', 'railcannon', 'grenadelauncher', 'nuke']
        ));
    }

    function isValidOptXp(xp, key) {
      return !(key in xp) || (xp[key] is int && xp[key] >= 0 && xp[key] <= 999999);
    }

    function isValidWeaponXpMap(xp, baseWep, allWep) {
      return xp is map
        && xp.keys().hasAll(baseWep)
        && xp.keys().hasOnly(allWep)
        && xp.rifle is int && xp.rifle >= 0 && xp.rifle <= 999999
        && xp.smg is int && xp.smg >= 0 && xp.smg <= 999999
        && xp.shotgun is int && xp.shotgun >= 0 && xp.shotgun <= 999999
        && xp.awp is int && xp.awp >= 0 && xp.awp <= 999999
        && xp.deagle is int && xp.deagle >= 0 && xp.deagle <= 999999
        && xp.pistol is int && xp.pistol >= 0 && xp.pistol <= 999999
        && isValidOptXp(xp, 'revolver')
        && isValidOptXp(xp, 'famas')
        && isValidOptXp(xp, 'scar')
        && isValidOptXp(xp, 'honeybadger')
        && isValidOptXp(xp, 'mp7')
        && isValidOptXp(xp, 'sawedoff')
        && isValidOptXp(xp, 'leverslug')
        && isValidOptXp(xp, 'dmr')
        && isValidOptXp(xp, 'scout')
        && isValidOptXp(xp, 'katana')
        && isValidOptXp(xp, 'g18')
        && isValidOptXp(xp, 'akimbo')
        && isValidOptXp(xp, 'usps');
    }

    function isValidOptSkin(skins, key) {
      return !(key in skins) || (skins[key] is string && skins[key].size() <= 64);
    }

    function isValidWeaponSkinsMap(skins, baseWep, allWep) {
      return skins is map
        && skins.keys().hasAll(baseWep)
        && skins.keys().hasOnly(allWep)
        && skins.rifle is string && skins.rifle.size() <= 64
        && skins.smg is string && skins.smg.size() <= 64
        && skins.shotgun is string && skins.shotgun.size() <= 64
        && skins.awp is string && skins.awp.size() <= 64
        && skins.deagle is string && skins.deagle.size() <= 64
        && skins.pistol is string && skins.pistol.size() <= 64
        && isValidOptSkin(skins, 'revolver')
        && isValidOptSkin(skins, 'famas')
        && isValidOptSkin(skins, 'scar')
        && isValidOptSkin(skins, 'honeybadger')
        && isValidOptSkin(skins, 'mp7')
        && isValidOptSkin(skins, 'sawedoff')
        && isValidOptSkin(skins, 'leverslug')
        && isValidOptSkin(skins, 'dmr')
        && isValidOptSkin(skins, 'scout')
        && isValidOptSkin(skins, 'katana')
        && isValidOptSkin(skins, 'g18')
        && isValidOptSkin(skins, 'akimbo')
        && isValidOptSkin(skins, 'usps');
    }

    function isValidCamoProgressMap(cp, allWep) {
      return cp is map
        && cp.size() <= 19
        && cp.keys().hasOnly(allWep);
    }

    function isValidEquippedCamosMap(ec, allWep) {
      return ec is map
        && ec.size() <= 19
        && ec.keys().hasOnly(allWep);
    }

    function isValidUserLoadoutsShape(data, uid) {
      let reqKeys = ['uid', 'activeIndex', 'loadouts', 'weaponXp', 'equippedWeaponSkins', 'createdAt', 'updatedAt'];
      let allKeys = ['uid', 'activeIndex', 'loadouts', 'weaponXp', 'equippedWeaponSkins', 'camoProgress', 'equippedWeaponCamos', 'createdAt', 'updatedAt'];
      let attSlots = ['optic', 'muzzle', 'barrel', 'underbarrel', 'magazine', 'ammo', 'rearGrip', 'stock', 'apex'];
      let primWep = ['rifle', 'famas', 'scar', 'honeybadger', 'smg', 'mp7', 'shotgun', 'sawedoff', 'leverslug', 'awp', 'dmr', 'scout', 'katana', 'revolver'];
      let secWep = ['deagle', 'pistol', 'g18', 'akimbo', 'usps'];
      let baseWep = ['rifle', 'smg', 'shotgun', 'awp', 'deagle', 'pistol'];
      let allWep = ['rifle', 'famas', 'scar', 'honeybadger', 'smg', 'mp7', 'shotgun', 'sawedoff', 'leverslug', 'awp', 'dmr', 'scout', 'katana', 'revolver', 'deagle', 'pistol', 'g18', 'akimbo', 'usps'];
      let ls = data.loadouts;
      return data.keys().hasAll(reqKeys)
        && data.keys().hasOnly(allKeys)
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.activeIndex is int
        && data.activeIndex >= 0
        && data.activeIndex <= 4
        && ls is list
        && ls.size() == 5
        && isValidLoadoutEntry(ls[0], 'loadout_1', primWep, secWep, attSlots)
        && isValidLoadoutEntry(ls[1], 'loadout_2', primWep, secWep, attSlots)
        && isValidLoadoutEntry(ls[2], 'loadout_3', primWep, secWep, attSlots)
        && isValidLoadoutEntry(ls[3], 'loadout_4', primWep, secWep, attSlots)
        && isValidLoadoutEntry(ls[4], 'loadout_5', primWep, secWep, attSlots)
        && isValidWeaponXpMap(data.weaponXp, baseWep, allWep)
        && isValidWeaponSkinsMap(data.equippedWeaponSkins, baseWep, allWep)
        && (!('camoProgress' in data) || isValidCamoProgressMap(data.camoProgress, allWep))
        && (!('equippedWeaponCamos' in data) || isValidEquippedCamosMap(data.equippedWeaponCamos, allWep))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserLoadoutsCreate(data, uid) {
      return isValidUserLoadoutsShape(data, uid)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserLoadoutsUpdate(data, uid) {
      return isValidUserLoadoutsShape(data, uid)
        && data.updatedAt == request.time;
    }

    // ---------- Collection Rules: Private User Settings ----------
    match /userSettings/{uid} {
      allow get: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserSettingsCreate(incoming(), uid);

      allow update: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserSettingsUpdate(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'sensitivity',
          'invertY',
          'baseFov',
          'crosshair',
          'viewmodel',
          'keybinds',
          'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && existing().uid == request.auth.uid;
    }

    // ---------- Collection Rules: Private User Inventory & Knives ----------
    match /userInventory/{uid} {
      allow get: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserInventoryCreate(incoming(), uid);

      allow update: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserInventoryUpdate(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().totalOpened >= existing().totalOpened
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'coins',
          'equippedKnifeId',
          'equippedGloveId',
          'equippedRifleId',
          'equippedAwpId',
          'equippedDeagleId',
          'caseCounts',
          'totalOpened',
          'lastDailyDropDate',
          'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && existing().uid == request.auth.uid;

      match /knives/{knifeId} {
        allow get: if isSignedIn()
          && isValidId(uid)
          && isValidId(knifeId)
          && request.auth.uid == uid
          && (resource == null || existing().uid == request.auth.uid);

        allow list: if isSignedIn()
          && isValidId(uid)
          && request.auth.uid == uid
          && existing().uid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(uid)
          && isValidId(knifeId)
          && request.auth.uid == uid
          && isValidKnifeItemCreate(incoming(), uid, knifeId)
          && exists(/databases/$(database)/documents/userInventory/$(uid));

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidId(uid)
          && isValidId(knifeId)
          && request.auth.uid == uid
          && (resource == null || existing().uid == request.auth.uid);
      }

      match /gloves/{gloveId} {
        allow get: if isSignedIn()
          && isValidId(uid)
          && isValidId(gloveId)
          && request.auth.uid == uid
          && (resource == null || existing().uid == request.auth.uid);

        allow list: if isSignedIn()
          && isValidId(uid)
          && request.auth.uid == uid
          && existing().uid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(uid)
          && isValidId(gloveId)
          && request.auth.uid == uid
          && isValidGloveItemCreate(incoming(), uid, gloveId)
          && exists(/databases/$(database)/documents/userInventory/$(uid));

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidId(uid)
          && isValidId(gloveId)
          && request.auth.uid == uid
          && (resource == null || existing().uid == request.auth.uid);
      }

      match /weapons/{weaponId} {
        allow get: if isSignedIn()
          && isValidId(uid)
          && isValidId(weaponId)
          && request.auth.uid == uid
          && (resource == null || existing().uid == request.auth.uid);

        allow list: if isSignedIn()
          && isValidId(uid)
          && request.auth.uid == uid
          && existing().uid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(uid)
          && isValidId(weaponId)
          && request.auth.uid == uid
          && isValidWeaponItemCreate(incoming(), uid, weaponId)
          && exists(/databases/$(database)/documents/userInventory/$(uid));

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidId(uid)
          && isValidId(weaponId)
          && request.auth.uid == uid
          && (resource == null || existing().uid == request.auth.uid);
      }
    }

    // ---------- Collection Rules: Private User Loadouts & Gunsmith ----------
    match /userLoadouts/{uid} {
      allow get: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserLoadoutsCreate(incoming(), uid);

      allow update: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserLoadoutsUpdate(incoming(), uid)
        && (!('uid' in existing()) || incoming().uid == existing().uid)
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'uid',
          'activeIndex',
          'loadouts',
          'weaponXp',
          'equippedWeaponSkins',
          'camoProgress',
          'equippedWeaponCamos',
          'createdAt',
          'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && existing().uid == request.auth.uid;
    }

    // ---------- Collection Rules: Serverless WebRTC Arena Lobbies ----------
    match /lobbies/{lobbyId} {
      allow get: if isSignedIn()
        && isValidId(lobbyId);

      allow list: if isSignedIn()
        && existing().isPrivate == false
        && existing().status in ['open', 'in_progress'];

      allow create: if isSignedIn()
        && isValidId(lobbyId)
        && isValidLobbyCreate(incoming(), lobbyId);

      allow update: if isSignedIn()
        && isValidId(lobbyId)
        && existing().hostUid == request.auth.uid
        && isValidLobbyUpdate(incoming(), lobbyId)
        && incoming().lobbyId == existing().lobbyId
        && incoming().hostUid == existing().hostUid
        && incoming().isPrivate == existing().isPrivate
        && incoming().joinCode == existing().joinCode
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'roomName',
          'mapId',
          'mode',
          'maxPlayers',
          'playerCount',
          'status',
          'heartbeatAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(lobbyId)
        && existing().hostUid == request.auth.uid;

      match /peers/{peerUid} {
        allow get: if isSignedIn()
          && isValidId(lobbyId)
          && isValidId(peerUid)
          && (request.auth.uid == peerUid || existing().hostUid == request.auth.uid);

        allow list: if isSignedIn()
          && isValidId(lobbyId)
          && existing().hostUid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(lobbyId)
          && isValidId(peerUid)
          && request.auth.uid == peerUid
          && isValidLobbyPeerShape(incoming(), peerUid)
          && incoming().state == 'offering'
          && incoming().answerSdp == ''
          && incoming().answerCandidates.size() == 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/lobbies/$(lobbyId))
          && get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.status in ['open', 'in_progress']
          && incoming().hostUid == get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid;

        allow update: if isSignedIn()
          && isValidId(lobbyId)
          && isValidId(peerUid)
          && isValidLobbyPeerShape(incoming(), peerUid)
          && incoming().peerUid == existing().peerUid
          && incoming().hostUid == existing().hostUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              request.auth.uid == peerUid
              && incoming().offerSdp == existing().offerSdp
              && incoming().answerSdp == existing().answerSdp
              && incoming().answerCandidates == existing().answerCandidates
              && incoming().diff(existing()).affectedKeys().hasOnly(['offerCandidates', 'state', 'updatedAt'])
            )
            || (
              request.auth.uid == existing().hostUid
              && incoming().offerSdp == existing().offerSdp
              && incoming().offerCandidates == existing().offerCandidates
              && incoming().diff(existing()).affectedKeys().hasOnly(['answerSdp', 'answerCandidates', 'state', 'updatedAt'])
            )
          );

        allow delete: if isSignedIn()
          && isValidId(lobbyId)
          && isValidId(peerUid)
          && (request.auth.uid == peerUid || existing().hostUid == request.auth.uid);
      }
    }

    // ---------- Collection Rules: Daily Courses ----------
    match /dailyCourses/{dateKey} {
      allow get: if isValidDateKey(dateKey) && existing().isPublic == true;
      allow list: if existing().isPublic == true;
      allow create: if isSignedIn()
        && isValidDateKey(dateKey)
        && isValidDailyCourse(incoming(), dateKey);
      allow update: if false;
      allow delete: if false;

      // ---------- Subcollection Rules: Daily Leaderboard Runs ----------
      match /runs/{uid} {
        allow get: if isValidDateKey(dateKey) && isValidId(uid) && existing().isPublic == true;
        allow list: if existing().bestTime > 0;

        allow create: if isSignedIn()
          && isValidDateKey(dateKey)
          && isValidId(uid)
          && request.auth.uid == uid
          && isValidDailyRunCreate(incoming(), dateKey, uid)
          && exists(/databases/$(database)/documents/dailyCourses/$(dateKey));

        allow update: if isSignedIn()
          && isValidDateKey(dateKey)
          && isValidId(uid)
          && request.auth.uid == uid
          && isValidDailyRunUpdate(incoming(), dateKey, uid)
          && (
            (
              // Action: Personal Best Improvement
              incoming().uid == existing().uid
              && incoming().dateKey == existing().dateKey
              && incoming().isPublic == existing().isPublic
              && incoming().createdAt == existing().createdAt
              && incoming().bestTime < existing().bestTime
              && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bestTime', 'splits', 'updatedAt'])
            )
            || (
              // Action: Display Name Update (preserves bestTime and splits)
              incoming().uid == existing().uid
              && incoming().dateKey == existing().dateKey
              && incoming().isPublic == existing().isPublic
              && incoming().createdAt == existing().createdAt
              && incoming().bestTime == existing().bestTime
              && incoming().splits == existing().splits
              && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
            )
          )
          && exists(/databases/$(database)/documents/dailyCourses/$(dateKey));

        allow delete: if isSignedIn()
          && isValidDateKey(dateKey)
          && isValidId(uid)
          && request.auth.uid == uid
          && existing().uid == request.auth.uid;
      }
    }
  }
}
