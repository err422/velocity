rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Reusable Hardened Primitives ----------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- Validation Blueprints ----------
    function isValidDailyCourse(data, dateKey) {
      return data.keys().hasAll([
          'dateKey',
          'seed',
          'lengthTier',
          'segmentCount',
          'mechanics',
          'isPublic',
          'createdBy',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'dateKey',
          'seed',
          'lengthTier',
          'segmentCount',
          'mechanics',
          'isPublic',
          'createdBy',
          'createdAt'
        ])
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey == dateKey
        && data.seed is string
        && data.seed.size() >= 4
        && data.seed.size() <= 64
        && data.seed.matches('^[A-Z0-9\\-]+$')
        && data.lengthTier is string
        && data.lengthTier.size() >= 4
        && data.lengthTier.size() <= 10
        && data.lengthTier in ['short', 'medium', 'long']
        && data.segmentCount is int
        && data.segmentCount >= 5
        && data.segmentCount <= 15
        && data.mechanics is list
        && data.mechanics.size() >= 1
        && data.mechanics.size() <= 8
        && data.mechanics[0] is string
        && data.mechanics.hasOnly(['ramp', 'gaps', 'wallrun', 'surf', 'slide', 'grapple', 'pads'])
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdBy is string
        && data.createdBy.size() >= 1
        && data.createdBy.size() <= 128
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidDailyRunShape(data, dateKey, uid) {
      return data.keys().hasAll([
          'uid',
          'dateKey',
          'displayName',
          'bestTime',
          'splits',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'dateKey',
          'displayName',
          'bestTime',
          'splits',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey == dateKey
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && data.bestTime is number
        && data.bestTime > 1.0
        && data.bestTime <= 3600.0
        && data.splits is list
        && data.splits.size() >= 1
        && data.splits.size() <= 32
        && data.splits[0] is number
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyRunCreate(data, dateKey, uid) {
      return isValidDailyRunShape(data, dateKey, uid)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidDailyRunUpdate(data, dateKey, uid) {
      return isValidDailyRunShape(data, dateKey, uid)
        && data.updatedAt == request.time;
    }

    // ---------- Collection Rules: Daily Courses ----------
    match /dailyCourses/{dateKey} {
      allow get: if isValidDateKey(dateKey) && existing().isPublic == true;
      allow list: if existing().isPublic == true;
      allow create: if isVerifiedUser()
        && isValidDateKey(dateKey)
        && isValidDailyCourse(incoming(), dateKey);
      allow update: if false;
      allow delete: if false;

      // ---------- Subcollection Rules: Daily Leaderboard Runs ----------
      match /runs/{uid} {
        allow get: if isValidDateKey(dateKey) && isValidId(uid) && existing().isPublic == true;
        allow list: if existing().bestTime > 0;

        allow create: if isVerifiedUser()
          && isValidDateKey(dateKey)
          && isValidId(uid)
          && request.auth.uid == uid
          && isValidDailyRunCreate(incoming(), dateKey, uid)
          && exists(/databases/$(database)/documents/dailyCourses/$(dateKey));

        allow update: if isVerifiedUser()
          && isValidDateKey(dateKey)
          && isValidId(uid)
          && request.auth.uid == uid
          && isValidDailyRunUpdate(incoming(), dateKey, uid)
          && (
            // Action: Personal Best Improvement
            incoming().uid == existing().uid
            && incoming().dateKey == existing().dateKey
            && incoming().isPublic == existing().isPublic
            && incoming().createdAt == existing().createdAt
            && incoming().bestTime < existing().bestTime
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bestTime', 'splits', 'updatedAt'])
          )
          && exists(/databases/$(database)/documents/dailyCourses/$(dateKey));

        allow delete: if isVerifiedUser()
          && isValidDateKey(dateKey)
          && isValidId(uid)
          && request.auth.uid == uid
          && existing().uid == request.auth.uid;
      }
    }
  }
}
